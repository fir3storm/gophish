# Gophish next to AwareCheck on the same VPS.
# nginx already owns :80 / :443. Gophish listens on localhost only.
#
# DNS (GoDaddy / wherever awarechck.com is hosted):
#   A    gophish    77.107.95.65
#   A    phish      77.107.95.65
#
# After HTTP is working:
#   certbot --nginx -d gophish.awarechck.com -d phish.awarechck.com

# Admin UI  →  https://gophish.awarechck.com
server {
    listen 80;
    server_name __ADMIN_HOST__;

    location / {
        proxy_pass http://127.0.0.1:__ADMIN_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
    }
}

# Campaign landing / tracking  →  https://phish.awarechck.com
server {
    listen 80;
    server_name __PHISH_HOST__;

    location / {
        proxy_pass http://127.0.0.1:__PHISH_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
